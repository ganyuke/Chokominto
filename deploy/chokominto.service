[Unit]
Description=Chokominto scrobble server
After=network-online.target
Wants=network-online.target

[Service]
User=chokominto
Group=chokominto
ExecStart=/usr/local/bin/chokominto serve -config /etc/chokominto/config.toml
Restart=on-failure
RestartSec=5

# Data lives in /var/lib/chokominto, owned by the chokominto account.
StateDirectory=chokominto
StateDirectoryMode=0700
UMask=0077

# Hardening. Chokominto only needs its data folder and the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
